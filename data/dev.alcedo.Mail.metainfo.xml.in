<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>dev.alcedo.Mail</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Alcedo</name>
  <summary>Native IMAP/SMTP mail client for GNOME</summary>
  <description>
    <p>
      Alcedo is a premium native mail client for GNOME with a unified inbox,
      multi-account support, and privacy-first defaults. Remote images and
      tracking pixels are blocked until you opt in; read receipts and outbound
      tracking pixels require explicit disclosure before sending.
    </p>
    <p>
      Supports Gmail and Yahoo app passwords, generic IMAP/SMTP accounts over
      TLS, and optional Google and Microsoft OAuth.
    </p>
  </description>
  <launchable type="desktop-id">dev.alcedo.Mail.desktop</launchable>
  <url type="homepage">@REPOSITORY_URL@</url>
  <developer id="dev.alcedo">
    <name>Alcedo Contributors</name>
  </developer>
  <screenshots>
    <screenshot type="default">
      <image>@SCREENSHOT_BASE_URL@/01-mail.png</image>
      <caption>Unified inbox with folders, the message list, and reader</caption>
    </screenshot>
    <screenshot>
      <image>@SCREENSHOT_BASE_URL@/02-reader.png</image>
      <caption>Read a message beside the conversation list</caption>
    </screenshot>
    <screenshot>
      <image>@SCREENSHOT_BASE_URL@/03-compose.png</image>
      <caption>Compose a new message in the reading pane</caption>
    </screenshot>
    <screenshot>
      <image>@SCREENSHOT_BASE_URL@/05-contacts.png</image>
      <caption>People and groups in the contacts view</caption>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="1.0.13" date="2026-11-21">
      <description>
        <p>Folders now tuck away: the folder button docks or undocks the column, and an undocked folder list slides out when you rest the pointer at the left edge and closes again when you leave. Narrow windows open with the folder list closed, and Escape or picking a folder closes it. The composer's back arrow is now a trash icon labelled Discard Draft, because leaving the composer discards the draft. The reader has a Compose button next to Reply and Forward. Tab moves straight from the To field to the next field, and the recipient picker button is no longer a stop in the tab order.</p>
      </description>
    </release>
    <release version="1.0.12" date="2026-11-20">
      <description>
        <p>No visible changes. Apps built on Alcedo's crates get better support for running rules on the mail server, translating their own text and cleaning up popovers.</p>
      </description>
    </release>
    <release version="1.0.11" date="2026-11-20">
      <description>
        <p>Fixed opening a view from an extension, such as Find all messages for an address, which could land on Everything instead of the results.</p>
      </description>
    </release>
    <release version="1.0.10" date="2026-11-19">
      <description>
        <p>Reply and Forward keep their icons on compact reader layouts instead of disappearing when the toolbar drops button labels.</p>
      </description>
    </release>
    <release version="1.0.9" date="2026-11-19">
      <description>
        <p>Alcedo is now available in French, Spanish, German and Italian, matching your desktop's language. English stays the default when no translation is installed.</p>
      </description>
    </release>
    <release version="1.0.8" date="2026-11-18">
      <description>
        <p>This release has no changes to the free app. It keeps Alcedo and Alcedo Pro on the same version, and Alcedo Pro is now also available as a Flatpak.</p>
      </description>
    </release>
    <release version="1.0.7" date="2026-11-18">
      <description>
        <p>The mail window now keeps its content inside narrower windows: toolbars drop their labels first, and the side panes make room at widths where they fit. Closed search and selection bars no longer take up space in the message list.</p>
      </description>
    </release>
    <release version="1.0.6" date="2026-11-18">
      <description>
        <p>Personal Outlook.com accounts now sign in through your browser with no setup. Sending from Microsoft accounts works with aliases, and sent mail no longer appears twice in the Sent folder. The activity log and error messages now fully hide passwords that contain an @.</p>
      </description>
    </release>
    <release version="1.0.5" date="2026-11-18">
      <description>
        <p>Calendar no longer shows a blank column beside the page. The header has a button to show or hide the side rail, the back button is labelled Mail, and the event detail pane stays hidden until you select an event.</p>
      </description>
    </release>
    <release version="1.0.4" date="2026-11-18">
      <description>
        <p>Gmail keeps read and starred state in step across a message's labels, so reading a message in one label marks it read in the others.</p>
      </description>
    </release>
    <release version="1.0.3" date="2026-11-18">
      <description>
        <p>Calendar RSVP replies use the attendee address from the invitation, so invitations sent to an alias are answered. The calendar chooser after Accept appears beside the RSVP buttons.</p>
      </description>
    </release>
    <release version="1.0.2" date="2026-11-17">
      <description>
        <p>Add account keeps a Provider you picked by hand when you type an address, so Gmail works with an app password under Other email. Sign-in docs now lead with Gmail app passwords.</p>
      </description>
    </release>
    <release version="1.0.1" date="2026-11-17">
      <description>
        <p>First packaged release for Ubuntu 26.04.</p>
      </description>
    </release>
    <release version="1.0.0" date="2026-11-16">
      <description>
        <p>First public release.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-08-13">
      <description>
        <p>Initial development release.</p>
      </description>
    </release>
  </releases>
</component>
